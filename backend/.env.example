# Postgres connection string. Railway injects this automatically when you
# attach a Postgres plugin; set it manually for local development.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/life_rpg

# Generate with: openssl rand -hex 32
JWT_SECRET_KEY=changeme-generate-a-real-32-byte-secret

JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14

# Exact origin of the deployed React app (no trailing slash). No wildcards.
FRONTEND_ORIGIN=http://localhost:5173

# development | production - gates /docs, /redoc, and error verbosity
ENVIRONMENT=development
